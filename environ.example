$project_workdir="$PSScriptRoot"
# Full initialization creates a fresh debug folder with settings, logs and errors.

$InitType = "full"
$settings = @{
    HuduBaseDomain          = "https://changeme.huducloud.com" # Note- Keep this URL Format. No trailing slashes, please
    ITGURL                  = "https://changeme.itglue.com"    # Note- Keep this URL Format. No trailing slashes, please
    ITGAPIEndpoint          = "https://api.itglue.com"         # Note- Keep this URL Format. No trailing slashes, please
    InternalCompany         = "changeme inc."
    ITGlueExportPath        = "c:\tmp\export" # Absolute path to extracted export, or desired export location for automatic download/extract

    # If $true, internal-company documents stay under that company instead of Hudu Global KB
    PlaceInternalDocsInInternalCompany = $false

    GlobalKBFolder          = "n" # Central folder KB articles.

    # Configs asset layout in Hudu Naming Prefix
    ConPromptPrefix         = ""

    # Flexible asset layout in Hudu Naming Prefix
    FAPromptPrefix          = ""

    # Split configurations into individual asset layouts?
    SplitConfigurations     = $false
}

# Primary Secrets
$ITGKey                     = "ITG.key"
$HuduApiKey                 = "HUDU.key"

# $ITGlueJWT = "" # "eyJ..." #only needed for checklists


# Individual Import Options
$ImportCompanies                     = $true  # default true;
$ImportLocations                     = $true  # default true;
$ImportDomains                       = $true  # default true;
$ImportConfigurations                = $true  # default true;
$ImportContacts                      = $true  # default true;
$ImportFlexibleAssetLayouts          = $true  # default true;
$ImportFlexibleAssets                = $true  # default true;
$ImportArticles                      = $true  # default true;
$ImportPasswords                     = $true  # default true;
$importPasswordFolders               = $true  # default true;

$ImportConfigInterfaces              = $true  # default true;  this creates IPAM addresses + networks in Hudu
$NonInteractive                      = $true  # Select $false for interactive steps, $true for noninteractive/no pauses (default)
$skipIntegratorLayouts               = $true  # do you want to skip flexible asset layouts from integrators? they are generally have the phrase '(auto)' in the name
$convertStandalonePhotoArticles      = $true  # Convert standalone image documents to Hudu Photos when the Photo feature is enabled.
$IncludeIgnoredFirstArticleDirectory = $true  # set this to 'false' to exclude the root level article folders (previously excluding these top level folders was expected behavior)
$DisableWebsiteMonitoring            = $false # default false;
$allowSettingFlagsAndTypes           = $false # Apply flags and flag types during the migration; requires Hudu 2.40+
$ScopedMigration                     = $false # If you want to scope migration to just come companies, set to 2/$true  (default 1/$false)
$MergedOrganizationTypes             = $false # if you want to merge vendors or other org types from ITG into a single organization, set to 2/$true (default 1/$false)
$importChecklists                    = $false # default false; (requires JWT authentication)
$GlobalPasswordFolderMode            = $false # or $true
# these require JWT authentication to perform [default is 1/false; 2 for true]
$PasswordFolderNameDelimiter = " - " # seperator when concatenating folders in squashed / flattened password folder
$FolderNamingMode = "Name Based on Full Path with Delimiter" # how to name the password folders which get flattened in hudu.
                    # "Name Based on Root-Level-Directory"
                    # "Name Based on Current/Leaf-Level Directory"


$LocImportAssetLayoutName   = "Locations" # name for locations layout
$ConImportAssetLayoutName   = "People" # name for contacts/people layout
$LayoutIconBackGroundColor      = "#6136ff" # hudu-purple background for layout icons
$LayoutIconForegroundColor      = "#ffffff" # White Foreground for layout icons

# pre-designated array/list of prescoped/preselected companies for scoped migration (for faster testing, ignore this if you want scoped migration, you'll select your own set)
# prescoped Companies
# $Prescoped = @(
# 905
# 859
#)

. "$PSScriptRoot\ITGlue-Hudu-Migration.ps1"
